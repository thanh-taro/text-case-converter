// Cloudflare Workers static assets, assets only, no Worker script (ADR-0006, MOD-Build).
// Deployed by hand with `pnpm deploy:prod` (scripts/deploy-prod.sh, ADR-0012); nothing here is a secret.
// Headers: dist/_headers (generated by `pnpm gen`, including the /sw.js exception).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-case-converter",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "text-case-converter.tarokit.app", "custom_domain": true }],
}
