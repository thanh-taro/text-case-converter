{
  "$description": "Text Case Converter design tokens (W3C DTCG). Base values mirror the taro-kit portal tokens (Night Market) and the JSON Formatter sibling so the tool looks native in the portal. Direction: Workbench. JSON-editor-specific roles (syntax colors, tree) are omitted; result-grid roles are added.",
  "color": {
    "$type": "color",
    "dark": {
      "bg": { "$type": "color", "$value": "#0F0B16", "$description": "page background" },
      "surface": { "$type": "color", "$value": "#18121F", "$description": "input, result rows, bars" },
      "surface2": { "$type": "color", "$value": "#221A2F", "$description": "row hover, key caps" },
      "line": { "$type": "color", "$value": "#2D2440", "$description": "hairline dividers (decorative)" },
      "lineStrong": { "$type": "color", "$value": "#6F6290", "$description": "borders that identify controls (>=3:1)" },
      "fg": { "$type": "color", "$value": "#EFEAF8", "$description": "primary text and result values" },
      "muted": { "$type": "color", "$value": "#9C92B0", "$description": "secondary text, case labels" },
      "accent": { "$type": "color", "$value": "#A47BFF", "$description": "brand violet: focus ring, highlights" },
      "onAccent": { "$type": "color", "$value": "#0F0B16", "$description": "text on accent fills" },
      "accent2": { "$type": "color", "$value": "#FFB870", "$description": "mango accent (sparing)" },
      "accent2Fg": { "$type": "color", "$value": "#FFC48A", "$description": "text on warn tint" },
      "selection": { "$type": "color", "$value": "#2A1D47", "$description": "focused/active row background" },
      "selectionLine": { "$type": "color", "$value": "#4A3580", "$description": "focused row outline" },
      "danger": { "$type": "color", "$value": "#FF8595", "$description": "error text" },
      "success": { "$type": "color", "$value": "#5BD6A0", "$description": "success text, privacy badge, copied" },
      "scrim": { "$type": "color", "$value": "#07050BB3", "$description": "modal backdrop" },
      "chrome": { "$type": "color", "$value": "#140F1EB8", "$description": "translucent app-shell bar" },
      "dangerBg": { "$type": "color", "$value": "#3A1622", "$description": "copy-failed notice background" },
      "warnBg": { "$type": "color", "$value": "#33240F", "$description": "large-input notice background" },
      "successBg": { "$type": "color", "$value": "#10291F", "$description": "copied-row flash background" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#FBFAFE" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface2": { "$type": "color", "$value": "#F1EDFA" },
      "line": { "$type": "color", "$value": "#E2DCF0" },
      "lineStrong": { "$type": "color", "$value": "#8C82A2" },
      "fg": { "$type": "color", "$value": "#16111F" },
      "muted": { "$type": "color", "$value": "#5E566F" },
      "accent": { "$type": "color", "$value": "#6837E0" },
      "onAccent": { "$type": "color", "$value": "#FFFFFF" },
      "accent2": { "$type": "color", "$value": "#B85E08" },
      "accent2Fg": { "$type": "color", "$value": "#8F4705" },
      "selection": { "$type": "color", "$value": "#F0EAFE" },
      "selectionLine": { "$type": "color", "$value": "#CDBBF8" },
      "danger": { "$type": "color", "$value": "#C0243B" },
      "success": { "$type": "color", "$value": "#13744C" },
      "scrim": { "$type": "color", "$value": "#16111F66" },
      "chrome": { "$type": "color", "$value": "#FFFFFFD1" },
      "dangerBg": { "$type": "color", "$value": "#FCE8EC", "$description": "copy-failed notice background" },
      "warnBg": { "$type": "color", "$value": "#FDEBD8", "$description": "large-input notice background" },
      "successBg": { "$type": "color", "$value": "#E7F6EF", "$description": "copied-row flash background" }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Unbounded", "system-ui", "sans-serif"],
        "$description": "portal header only; not used inside the tool"
      },
      "body": { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"],
        "$description": "input text and result values"
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "13px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "15px" },
      "lg": { "$type": "dimension", "$value": "17px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "input": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "form fields; 16px avoids zoom-on-focus on mobile"
      },
      "code": { "$type": "dimension", "$value": "13px", "$description": "result values and input text" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.15 },
      "normal": { "$type": "number", "$value": 1.55 },
      "code": { "$type": "number", "$value": 1.5385, "$description": "20px lines at 13px" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "7px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "statusbar": { "$type": "dimension", "$value": "28px", "$description": "status bar height" },
    "control": { "$type": "dimension", "$value": "28px", "$description": "buttons (clear, dismiss)" },
    "resultRow": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "result row min height; the row is the copy target"
    },
    "labelCol": {
      "$type": "dimension",
      "$value": "120px",
      "$description": "case-label column width at wide widths; rows stack below size.stackAt"
    },
    "stackAt": {
      "$type": "dimension",
      "$value": "400px",
      "$description": "below this width the result row stacks label above value"
    },
    "inputMinHeight": { "$type": "dimension", "$value": "96px", "$description": "minimum input area height" },
    "codeLine": { "$type": "dimension", "$value": "20px", "$description": "input and value line height" },
    "targetMin": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "minimum pointer target (WCAG 2.2 AA 2.5.8)"
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "target size when the primary pointer is coarse"
    },
    "icon": {
      "sm": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "20px" }
    },
    "minWidth": {
      "$type": "dimension",
      "$value": "320px",
      "$description": "smallest supported width (NFR-06, WCAG reflow)"
    },
    "contentMax": {
      "$type": "dimension",
      "$value": "720px",
      "$description": "max content width standalone (comfortable reading of results)"
    }
  },
  "border": {
    "width": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "focus": { "$type": "dimension", "$value": "2px" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "260ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },
  "contrast": {
    "$description": "Text/background pairs checked for WCAG AA in every theme (min ratio).",
    "pairs": {
      "$type": "string",
      "$value": "fg/bg 4.5, fg/surface 4.5, fg/surface2 4.5, fg/selection 4.5, fg/successBg 4.5, muted/bg 4.5, muted/surface 4.5, muted/surface2 4.5, muted/successBg 4.5, accent/bg 4.5, accent/surface 4.5, accent/successBg 3, onAccent/accent 4.5, danger/surface 4.5, danger/dangerBg 4.5, accent2Fg/warnBg 4.5, success/surface 4.5, success/surface2 4.5, success/successBg 4.5, lineStrong/surface 3, lineStrong/bg 3"
    }
  }
}
